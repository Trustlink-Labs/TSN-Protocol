# Creditcoin CC3 Testnet. This is not Solana localnet or Creditcoin mainnet.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031

# Funded testnet deployer key. Keep the key outside Git and prefer the local
# Git-ignored file reference supported by scripts/deploy.ts.
DEPLOYER_PRIVATE_KEY_FILE=.creds/contract_auth_keypair.json

# Creditcoin settlement policy. The authorization signer binds the complete
# route, destination executor, recipient, amount, and Solana commitment. The
# Cranker only submits the exact authorized settlement transaction.
CREDITCOIN_AUTHORIZATION_SIGNER=

# Attestcoin proof builder for CC3 Testnet.
PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network
SOURCE_CHAIN_KEY=1

# DestinationRegistry testnet governance defaults. These do not activate a
# route; they define the minimum quorum and delay for a proposal.
DESTINATION_REGISTRY_QUORUM=2
DESTINATION_REGISTRY_VOTING_PERIOD=604800
DESTINATION_REGISTRY_ACTIVATION_DELAY=86400

# Written to deployments/creditcoin-latest.json after core deployment.
CREDITCOIN_SETTLEMENT_HUB_ADDRESS=

# Destination-chain values are used only by deploy:destination and must be
# supplied per supported EVM destination. They are not required for the
# Creditcoin core deployment above. Never use localhost/localnet.
DESTINATION_RPC_URL=
DESTINATION_DEPLOYER_PRIVATE_KEY=
DESTINATION_NETWORK=base
DESTINATION_TOKEN=
DESTINATION_ATTESTCOIN_INBOX=
CREDITCOIN_SETTLEMENT_HUB=

# Route configuration is a separate operation after destination deployment.
DESTINATION_ROUTE_ID=
DESTINATION_LIQUIDITY_TX_HASH=

# On-chain route configuration. Set these only after the destination vault,
# executor, stablecoin, and Attestcoin Outbox have been deployed and verified.
CREDITCOIN_LIQUIDITY_REGISTRY=
TSN_ROUTE_ID=
TSN_DESTINATION_NETWORK=
TSN_SOURCE_CHAIN_KEY=
TSN_SOURCE_EMITTER=
TSN_PAYOUT_VAULT=
TSN_DESTINATION_TOKEN=
TSN_DESTINATION_CHAIN_ID=
TSN_DESTINATION_EXECUTOR=
ATTESTCOIN_OUTBOX_ADDRESS=

# The direct Creditcoin deployment creates USDSET and wires its address into
# the vault and route registry. Runtime settlement never reads a token address
# from environment data. This amount is explicit because the test asset is
# intentionally mintable by its owner.
USDSET_INITIAL_SUPPLY=


# Real evidence verifier inputs. These must be mined transactions from the
# current run; placeholders are rejected and no hashes are generated.
TSN_NODE_URL=http://127.0.0.1:8000
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_INTENT_TX_SIGNATURE=
CREDITCOIN_SETTLEMENT_TX_HASH=
